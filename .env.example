# No real credentials belong in Git. Use separate provider projects/keys per environment.
APP_ENV=development
SITE_URL=http://localhost:4174
SITE_INDEXABLE=false
# Supabase public project values; browser build only exposes these two.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only; never prefix private values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Test mode by default; live requires production + explicit approved activation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=false
# Resend: verified domain required in production. Test recipient required outside production.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_RECIPIENT=
EMAIL_SENDING_ENABLED=false
# Owner-generated secret to authorize the outbox job. Never exposed to browsers.
JOB_SECRET=
# Browser PostHog project key; not a personal API key. EU endpoint is configurable.
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Set after approving privacy wording + UI. No trackers load without explicit opt-in.
CONSENT_POLICY_VERSION=
# Error monitoring keys. Frontend monitoring also waits for analytics consent.
SENTRY_DSN=
SENTRY_PUBLIC_DSN=
# Vercel supplies these at runtime/build:
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
# Optional Vercel-compatible cron secret. No cron is enabled by default.
CRON_SECRET=
